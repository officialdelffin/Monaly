<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".ui.activity.MainActivity">

    <!-- O trilho Global  : -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerMain"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/customBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Barra de navegação flutuante : -->
    <LinearLayout
        android:id="@+id/customBottomNav"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/drawable_background_button_gray_deep_10_dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Icone Início : -->
        <ImageView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_home_bage_neutral" />

        <!-- Icone Galeria : -->
        <ImageView
            android:id="@+id/navGallery"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_gallery_bage_neutral" />

        <!-- Icone Álbuns : -->
        <ImageView
            android:id="@+id/navAlbums"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_albums_bage_neutral" />

        <!-- Icone Perfil : -->
        <ImageView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_profile_bage_neutral" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>