<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Imagem de fundo do Álbum que ocupará todo o espaço disponível : -->
    <ImageView
        android:id="@+id/imageAlbumCover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@color/gray_dark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Película de gradiente preto para dar contraste aos textos : -->
    <View
        android:layout_width="0dp"
        android:layout_height="250dp"
        android:background="@drawable/bg_gradient_black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- A Tag indicando se é Público ou Compartilhado : -->
    <TextView
        android:id="@+id/textAlbumTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginBottom="30dp"
        android:text="Álbum compartilhado - Público"
        android:textColor="@color/gray_medium"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- A Descrição do Álbum (com limite de linhas para não quebrar o layout) : -->
    <TextView
        android:id="@+id/textAlbumDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="15dp"
        android:ellipsize="end"
        android:maxLines="4"
        android:text="Descrição do álbum vai aqui. Preparado para receber textos grandes do banco de dados sem deformar a tela."
        android:textColor="@color/bage_neutral"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@+id/textAlbumTag"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- O Título Principal do Álbum : -->
    <TextView
        android:id="@+id/textAlbumTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="10dp"
        android:text="Título do Álbum"
        android:textColor="@color/bage_neutral"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/textAlbumDescription"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>