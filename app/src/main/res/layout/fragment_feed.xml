<?xml version="1.0" encoding="utf-8"?>
<!-- Substituímos o FrameLayout primitivo pelo ConstraintLayout escalável : -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".ui.fragment.navegation.FeedFragment">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonAdd"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="15dp"
        android:background="@drawable/drawable_background_button_bage_10_dp"
        android:text="@string/feed_button_to_add"
        android:textColor="@color/gray_dark"
        android:textAllCaps="false"
        android:gravity="start|center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/buttonNotification"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonNotification"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="15dp"
        android:background="@drawable/drawable_background_button_gray_dark_10_dp"
        android:text="N"
        android:textColor="@color/bage_neutral"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textDefaultAlbun"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:text="@string/feed__defaut_number"
        android:textColor="@color/bage_neutral"
        android:textSize="25dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonAdd"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textDefaultConection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:text="@string/feed__defaut_number"
        android:textColor="@color/bage_neutral"
        android:textSize="25dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonNotification"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/textDefaultAlbun" />

    <TextView
        android:id="@+id/textDefaultMidia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:text="@string/feed__defaut_number"
        android:textColor="@color/bage_neutral"
        android:textSize="25dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonAdd"
        app:layout_constraintEnd_toStartOf="@+id/textDefaultAlbun"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textTitleAlbun"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:text="@string/feed_title_albuns"
        android:textColor="@color/bage_neutral"
        android:textSize="18dp"
        app:layout_constraintBottom_toTopOf="@+id/textDefaultAlbun"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textTitleConection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:text="@string/feed_title_conections"
        android:textColor="@color/bage_neutral"
        android:textSize="18dp"
        app:layout_constraintBottom_toTopOf="@+id/textDefaultConection"
        app:layout_constraintEnd_toEndOf="@+id/textDefaultConection"
        app:layout_constraintStart_toStartOf="@+id/textDefaultConection" />

    <TextView
        android:id="@+id/textTitleMidia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:text="@string/feed_title_midia"
        android:textColor="@color/bage_neutral"
        android:textSize="18dp"
        app:layout_constraintBottom_toTopOf="@+id/textDefaultMidia"
        app:layout_constraintEnd_toEndOf="@+id/textDefaultMidia"
        app:layout_constraintStart_toStartOf="@+id/textDefaultMidia" />

</androidx.constraintlayout.widget.ConstraintLayout>