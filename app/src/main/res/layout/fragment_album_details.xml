<?xml version="1.0" encoding="utf-8"?>


<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">


    <!-- Área de rolagem para englobar o cabeçalho e a grade de mídias sem cobrir o botão base : -->


    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollAlbumDetails"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="20dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/buttonAddMedia"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <!-- Contêiner interno organizando os elementos de topo para baixo : -->


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="20dp">


            <!-- Imagem de capa do álbum ocupando o topo : -->


            <ImageView
                android:id="@+id/ivDetailCover"
                android:layout_width="0dp"
                android:layout_height="400dp"
                android:background="@color/gray_dark"
                android:scaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <!-- Gradiente escuro garantindo a leitura dos textos sobrepostos : -->


            <View
                android:id="@+id/viewGradientDetail"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_gradient_black"
                app:layout_constraintBottom_toBottomOf="@+id/ivDetailCover"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/ivDetailCover" />


            <!-- Botão de voltar no canto superior esquerdo : -->


            <ImageView
                android:id="@+id/btnBackDetail"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="40dp"
                android:padding="12dp"
                android:src="@drawable/icon_arrow_back_ios"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#FFFFFF" />


            <!-- Status do álbum exibido acima do título : -->


            <TextView
                android:id="@+id/tvDetailStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="15dp"
                android:textColor="@color/gray_medium"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@+id/tvDetailTitle"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="Álbum compartilhado - Privado" />


            <!-- Menu de opções de três pontos no canto direito : -->


            <!-- Título principal do álbum : -->


            <ImageView
                android:id="@+id/btnDetailMenu"
                android:layout_width="48dp"
                android:layout_height="0dp"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_more"
                app:layout_constraintBottom_toBottomOf="@+id/tvDetailTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvDetailTitle"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="15dp"
                android:textColor="@color/bage_neutral"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/tvDetailDescription"
                app:layout_constraintEnd_toStartOf="@+id/btnDetailMenu"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="Visita aos campos de Girassóis" />


            <!-- Descrição textual do álbum : -->


            <TextView
                android:id="@+id/tvDetailDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="20dp"
                android:textColor="@color/gray_medium"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="@+id/ivDetailCover"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="Sobre o dia entre os girassóis..." />


            <!-- Título da seção de participantes : -->


            <TextView
                android:id="@+id/tvParticipantsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:text="@string/create_album_participants_title"
                android:textColor="@color/bage_neutral"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivDetailCover" />


            <!-- Mock visual representando a área de participantes : -->


            <LinearLayout
                android:id="@+id/llParticipantsMock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvParticipantsTitle">


                <!-- Espaço reservado para os avatares arredondados da equipe : -->


                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/drawable_background_button_gray_deep_10_dp"
                    android:src="@drawable/ic_profile_bage_neutral" />


                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/drawable_background_button_gray_deep_10_dp"
                    android:src="@drawable/ic_profile_bage_neutral" />


                <!-- Indicador visual para visualizar o restante da lista : -->


                <TextView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/drawable_background_button_gray_deep_10_dp"
                    android:gravity="center"
                    android:text="..."
                    android:textColor="@color/bage_neutral"
                    android:textSize="18sp"
                    android:textStyle="bold" />


            </LinearLayout>


            <!-- Lista principal estruturada para receber as mídias e datas dinâmicas : -->


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAlbumMedia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:nestedScrollingEnabled="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llParticipantsMock" />


        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.core.widget.NestedScrollView>


    <!-- Botão de adição fixado acima da barra de navegação principal : -->


    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonAddMedia"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/drawable_background_button_gray_dark_10_dp"
        android:gravity="start|center_vertical"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        android:text="@string/feed_button_to_add"
        android:textAllCaps="false"
        android:textColor="@color/gray_dark"
        android:textSize="20sp"
        app:backgroundTint="@color/bage_neutral"
        app:icon="@drawable/ic_add_gray_dark"
        app:iconGravity="end"
        app:iconSize="24dp"
        app:iconTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>